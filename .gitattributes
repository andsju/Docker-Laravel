# Normalize all text files to LF in the repo and on checkout
* text=auto eol=lf

# Explicitly enforce LF for files executed in Linux containers
*.sh   text eol=lf
*.php  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.ini  text eol=lf
*.env  text eol=lf
*.json text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.xml  text eol=lf

# Binary files – no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
