APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Port exposed on the host for the web app
APP_PORT=8000

SESSION_DRIVER=file

DB_CONNECTION=mysql
# In Docker the database host is the service name defined in docker-compose.yml
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_ROOT_PASSWORD=
